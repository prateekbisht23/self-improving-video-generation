# --- Models (format: provider:model). Local/free by default via Ollama.
MODEL_PLANNER=ollama:qwen3:8b
MODEL_VISION=ollama:qwen2.5vl:7b
MODEL_JUDGE=ollama:qwen3:8b
MODEL_EMBEDDINGS=google_genai:gemini-embedding-001
EMBEDDING_DIM=768
# requests/minute cap per model (0 = unlimited); Gemini free tier allows 15
MODEL_RPM=0
OLLAMA_BASE_URL=http://localhost:11434
WHISPER_MODEL=small
# Google Gemini (free tier: https://aistudio.google.com/apikey):
# (list what your key can use: GET https://generativelanguage.googleapis.com/v1beta/models)
# MODEL_PLANNER=google_genai:gemini-3.5-flash-lite
# MODEL_VISION=google_genai:gemini-3.5-flash-lite
# MODEL_JUDGE=google_genai:gemini-3.5-flash-lite
# GOOGLE_API_KEY=
# Anthropic (paid; requires `uv sync --extra anthropic`):
# MODEL_PLANNER=anthropic:claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# --- LangSmith (free Developer plan: https://smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sivg-dev
# Region-specific API: US (default) https://api.smith.langchain.com,
# EU https://eu.api.smith.langchain.com, APAC https://apac.api.smith.langchain.com
# A key used against the wrong region gets 403 Forbidden.
# LANGSMITH_ENDPOINT=

# --- Infra (see docker-compose.yml)
DATABASE_URL=postgresql+psycopg://sivg:sivg@localhost:5433/sivg
REDIS_URL=redis://localhost:6380/0
